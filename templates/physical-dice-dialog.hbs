<div class="physical-dice-dialog-content">
  <!-- Header / Action Title & Target Info -->
  <div class="physical-dialog-header">
    <div class="physical-action-title">{{title}}</div>
    {{#if subtitle}}
    <div class="physical-action-subtitle">{{subtitle}}</div>
    {{/if}}
    {{#if target}}
    <div class="physical-target-badge">
      <i class="fa-solid fa-crosshairs"></i> Target: <strong>{{target.name}}</strong>
    </div>
    {{/if}}
  </div>

  <form class="physical-roll-form" onsubmit="return false;">
    {{#if isCheck}}
    <!-- Check / d20 Roll Entry Section -->
    <div class="physical-d20-section">
      <div class="physical-prompt-msg">
        {{#if isFortune}}
        <span class="text-fortune"><i class="fa-solid fa-clover"></i> <strong>Fortune:</strong></span> Roll 2d{{faces}}
        physically and enter the <em>higher</em> result:
        {{else if isMisfortune}}
        <span class="text-misfortune"><i class="fa-solid fa-skull"></i> <strong>Misfortune:</strong></span> Roll
        2d{{faces}} physically and enter the <em>lower</em> result:
        {{else if (gt count 1)}}
        Roll <strong>{{count}}d{{faces}}</strong> physically on the table:
        {{else}}
        Roll <strong>1d{{faces}}</strong> physically on the table:
        {{/if}}
        <div class="physical-prompt-subnote">Leave blank and click Submit to roll digitally.</div>
      </div>

      <div class="physical-input-row physical-check-input-row">
        <button type="button" class="btn-stepper btn-minus" data-action="step" data-step="-1"
          title="Decrease">
          <i class="fa-solid fa-minus"></i>
        </button>
        <label for="physical-d20-input" class="visually-hidden">d{{faces}} Result</label>
        <input type="number" id="physical-d20-input" name="d20-val"
          class="physical-die-input physical-number-input" inputmode="numeric" pattern="[0-9]*" min="1"
          max="{{faces}}" placeholder="1 - {{faces}}" autocomplete="off" autofocus />
        <button type="button" class="btn-stepper btn-plus" data-action="step" data-step="1"
          title="Increase">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>

      {{#if (eq faces 20)}}
      <div class="physical-quick-presets">
        <button type="button" class="btn-quick-preset" data-action="preset" data-val="1"
          title="Natural 1">Nat 1</button>
        <button type="button" class="btn-quick-preset" data-action="preset" data-val="20"
          title="Natural 20">Nat 20</button>
      </div>
      {{/if}}

      <div class="physical-modifier-info">
        Modifier: <strong>{{#if (gte modifier 0)}}+{{/if}}{{modifier}}</strong> (will be added automatically)
      </div>
      <div class="physical-error-msg hidden"></div>
    </div>

    {{else}}
    <!-- Damage Roll Entry Section (Multiple Dice Pools in Rows) -->
    <div class="physical-damage-section">
      <div class="physical-prompt-msg">
        Roll physical dice for each damage type and enter the total below:
        <div class="physical-prompt-subnote">Leave blank and click Submit to roll digitally.</div>
      </div>

      <div class="physical-damage-pools">
        {{#each pools}}
        <div class="physical-damage-row" data-pool-id="{{this.id}}">
          <div class="damage-row-header">
            <span class="damage-type-badge damage-{{this.type}}">
              {{this.typeLabel}}{{#if this.persistent}} (Persistent){{/if}}
            </span>
            <span class="damage-dice-instruction">
              <i class="fa-solid fa-dice"></i> Roll <strong>{{this.formula}}</strong>
            </span>
          </div>

          <div class="damage-input-row">
            <label for="pool-input-{{this.id}}">Dice Total:</label>
            <div class="physical-input-stepper-group">
              <button type="button" class="btn-stepper btn-minus" data-action="pool-step"
                data-pool-id="{{this.id}}" data-step="-1" title="Decrease">
                <i class="fa-solid fa-minus"></i>
              </button>
              <input type="number" id="pool-input-{{this.id}}" name="pool-{{this.id}}"
                class="physical-damage-input physical-number-input" inputmode="numeric" pattern="[0-9]*"
                data-pool-id="{{this.id}}" data-min="{{this.min}}" data-max="{{this.max}}" min="{{this.min}}"
                max="{{this.max}}" placeholder="{{this.min}} - {{this.max}}" autocomplete="off" {{#if
                @first}}autofocus{{/if}} />
              <button type="button" class="btn-stepper btn-plus" data-action="pool-step"
                data-pool-id="{{this.id}}" data-step="1" title="Increase">
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
          </div>

          {{#if this.mod}}
          <div class="damage-mod-note">
            Modifier: {{#if (gte this.mod 0)}}+{{/if}}{{this.mod}} {{this.typeLabel}} will be added automatically
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      <div class="physical-error-msg hidden"></div>
    </div>
    {{/if}}

    <!-- Dialog Actions -->
    <div class="physical-dialog-footer">
      <button type="button" class="btn-cancel" data-action="cancel">
        <i class="fa-solid fa-xmark"></i> Cancel
      </button>
      <button type="button" class="btn-submit btn-primary" data-action="submit">
        <i class="fa-solid fa-check"></i> Submit Roll
      </button>
    </div>
  </form>
</div>